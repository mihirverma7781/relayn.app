{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RelayN Player",
  "version": "0.1.0",
  "identifier": "com.aster.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "RelayN Player",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "dragDropEnabled": true,
        "backgroundColor": "#171A19"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Your media. In motion.",
    "resources": {
      "resources/vlc-3.0.24/": "vlc/"
    },
    "copyright": "Copyright 2026 RelayN Player contributors",
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "useLocalToolsDir": true
  }
}
